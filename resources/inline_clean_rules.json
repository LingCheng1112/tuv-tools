{
  "inline_clean_rules": [
    {
      "name": "test_date",
      "pattern": "(?:☐\\s*)?Test date\\s*:[^☐☒\\r\\n]*"
    },
    {
      "name": "ambient_temperature",
      "pattern": "(?:☐\\s*)?Ambient(?:\\s+temperature)?\\s*:[^☐☒\\r\\n]*"
    },
    {
      "name": "equipment_id",
      "pattern": "(?:☐\\s*)?Equipment ID\\s*:[^☐☒\\r\\n]*"
    },
    {
      "name": "sample_id",
      "pattern": "(?:☐\\s*)?Sample ID\\s*:?[^\\r\\n☐☒]*"
    },
    {
      "name": "equipment_no",
      "pattern": "(?:☐\\s*)?Equipment No\\s*:[^☐☒\\r\\n]*"
    }
  ]
}
